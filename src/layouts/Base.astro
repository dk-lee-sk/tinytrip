---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Show the feedback survey under the page (default true) */
  feedback?: boolean;
}

const {
  title,
  feedback = true,
  description = 'A calm, step-by-step guide for first-time parents planning their first trip with a baby.',
} = Astro.props;

const pageTitle = title ? `${title} · TinyTrip` : 'TinyTrip — Your First Trip with Baby';

// Main menu stays short; the rest sits under "More".
const links = [
  { href: '/ready', label: 'Is baby ready?' },
  { href: '/plan', label: 'My plan' },
  { href: '/pack', label: 'Pack list' },
  { href: '/travel-day', label: 'Travel day' },
  { href: '/meltdown', label: 'Meltdown help' },
];
const more = [
  { href: '/destinations', label: 'Destinations' },
  { href: '/ask', label: 'Questions to ask' },
  { href: '/sleep', label: 'Sleep' },
  { href: '/guides', label: 'Flying with a baby' },
  { href: '/why', label: 'Why I made this' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';

// Link previews (WhatsApp, iMessage, social) need absolute URLs.
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

// Cloudflare Web Analytics: counts visits without cookies or personal data.
// The token is public (it ships in every page). Only loads on the built site, not in dev.
const CF_ANALYTICS_TOKEN = '2f145cd1dc354dfca8d4791e42ba890d';
const analytics = import.meta.env.PROD && CF_ANALYTICS_TOKEN;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TinyTrip" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="TinyTrip: plan your first trip with a baby, one step at a time." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#E07A5F" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400&family=Nunito:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{pageTitle}</title>
    {analytics && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: CF_ANALYTICS_TOKEN })}
      ></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <nav class="site-nav" aria-label="Main">
      <a class="logo" href="/">TinyTrip</a>
      <ul>
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
        {/* Wide screens: a small "More" menu. Phones: the same links, inline in the scrolling row. */}
        <li class="nav-more-wrap">
          <details class="nav-more">
            <summary class:list={{ current: more.some((l) => l.href === path) }}>More</summary>
            <ul>
              {more.map((l) => (
                <li><a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a></li>
              ))}
            </ul>
          </details>
        </li>
        {more.map((l) => (
          <li class="nav-inline">
            <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <main id="main">
      <slot />
    </main>

    <!-- Netlify Forms picks this up at deploy time (form detection must be on in the Netlify dashboard). -->
    {feedback && (
    <form class="feedback" id="feedback" name="feedback" method="POST" action="/thanks" data-netlify="true" netlify-honeypot="bot-field">
      <input type="hidden" name="form-name" value="feedback" />
      <input type="hidden" name="page" value={path} />
      <p class="fb-honeypot" hidden><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
      <h2 class="fb-title">Three quick questions</h2>
      <p class="fb-intro">They go straight to the person who makes TinyTrip, and help make it better for the next parent.</p>
      <fieldset class="fb-q">
        <legend>1. Was this page helpful?</legend>
        <div class="fb-choices">
          <label class="fb-choice"><input type="radio" name="helpful" value="yes" required /> <span>Yes</span></label>
          <label class="fb-choice"><input type="radio" name="helpful" value="somewhat" /> <span>Somewhat</span></label>
          <label class="fb-choice"><input type="radio" name="helpful" value="not really" /> <span>Not really</span></label>
        </div>
      </fieldset>
      <fieldset class="fb-q">
        <legend>2. After reading it, how do you feel about the trip?</legend>
        <div class="fb-choices">
          <label class="fb-choice"><input type="radio" name="feeling" value="more ready" /> <span>More ready</span></label>
          <label class="fb-choice"><input type="radio" name="feeling" value="about the same" /> <span>About the same</span></label>
          <label class="fb-choice"><input type="radio" name="feeling" value="still worried" /> <span>Still worried</span></label>
        </div>
      </fieldset>
      <div class="fb-more">
        <label for="fb-message">3. How could we make it better? Anything missing or confusing? <span>(optional)</span></label>
        <textarea id="fb-message" name="message" rows="3" maxlength="2000"></textarea>
        <label for="fb-email">Your email, if you'd like a reply <span>(optional)</span></label>
        <input type="email" id="fb-email" name="email" autocomplete="email" />
        <p class="fb-note">Please don't include medical details. This isn't a way to get medical advice.</p>
        <button type="submit" class="btn-coral">Send</button>
      </div>
      <p class="fb-status" id="fb-status" role="status"></p>
    </form>
    )}

    <footer class="site-footer">
      <p>
        <strong>TinyTrip is a guide, not a doctor.</strong>
        Every baby is different, so check with your GP, health visitor or pharmacist about your own baby,
        especially if they're very young or unwell. Health and travel rules link to the official page they come
        from, and anything marked “still being double-checked” is waiting for a final review.
      </p>
      <p class="footer-made">TinyTrip is a small independent project, written with help from AI tools. <a href="/why">Why I made this</a></p>
    </footer>
    <script>
      // Send feedback without leaving the page. Without JS the form posts normally and lands on /thanks.
      const fb = document.getElementById('feedback') as HTMLFormElement | null;
      const status = document.getElementById('fb-status');
      if (fb && status) {
      fb.addEventListener('submit', async (e) => {
        e.preventDefault();
        const body = new URLSearchParams(new FormData(fb) as unknown as Record<string, string>);
        const button = fb.querySelector('button')!;
        button.disabled = true;
        try {
          const res = await fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString(),
          });
          if (!res.ok) throw new Error(String(res.status));
          fb.classList.add('sent');
          status.textContent = 'Thanks, that’s sent. Every message gets read.';
        } catch {
          button.disabled = false;
          status.textContent = "Sorry, that didn't send. Please try again in a moment.";
        }
      });
      }
    </script>
    <script>
    // Close the "More" menu when clicking elsewhere or pressing Escape.
    const menu = document.querySelector<HTMLDetailsElement>('.nav-more');
    const closeMore = (e: Event) => {
      if (!menu?.open) return;
      if (e instanceof KeyboardEvent ? e.key === 'Escape' : !menu.contains(e.target as Node)) menu.open = false;
    };
    document.addEventListener('click', closeMore);
    document.addEventListener('keydown', closeMore);
  </script>
  </body>
</html>
