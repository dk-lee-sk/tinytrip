---
import Base from '../layouts/Base.astro';
import destinations from '../data/destinations.json';
---

<Base title="Where to go first">
  <div class="inner wide">
    <p class="page-eyebrow">Where to go first</p>
    <h1 class="page-title">Ideas for an easy first trip</h1>
    <p class="page-sub">Easy first-trip ideas: good healthcare, step-free transport, room to slow down. Ideas, not rankings.</p>

    <ul class="dest-grid">
      {destinations.map((d) => (
        <li class="dest-card">
          <div class={`dest-img g-${d.colour}`} aria-hidden="true">{d.flag}</div>
          <div class="dest-info">
            <h2>{d.name}</h2>
            <p class="dest-loc">{d.region}</p>
            <ul class="dest-tags">{d.tags.map((t) => <li class="dt">{t}</li>)}</ul>
          </div>
        </li>
      ))}
    </ul>

    <div class="calm-box coming-soon">
      <h2>🧭 Why no scores?</h2>
      <p>
        We're working out a fair, sourced way to rate how baby-friendly a place is — things like healthcare access,
        step-free transport and baby-changing facilities. Until then, we'd rather show no number than a made-up one.
        The best first trip is usually somewhere close to home.
      </p>
    </div>
  </div>
</Base>

<style>
  .dest-grid { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-bottom: 32px; }
  .dest-card { background: var(--white); border-radius: 20px; overflow: hidden; box-shadow: var(--shadow); }
  .dest-img { height: 130px; display: flex; align-items: center; justify-content: center; font-size: 3rem; }
  .g-coral    { background: linear-gradient(135deg, #f7d5c8, #efb09a); }
  .g-sky      { background: linear-gradient(135deg, #c8dff0, #96c0e0); }
  .g-sage     { background: linear-gradient(135deg, #cee0d5, #9ec4b0); }
  .g-gold     { background: linear-gradient(135deg, #f5e4b0, #e8c870); }
  .g-lavender { background: linear-gradient(135deg, #e0d5f0, #c0a8e0); }
  .g-pink     { background: linear-gradient(135deg, #f5d0dc, #e8a0b4); }
  .dest-info { padding: 18px 20px; }
  .dest-info h2 { font-weight: 700; font-size: 1rem; margin-bottom: 4px; }
  .dest-loc { font-size: 0.8rem; color: var(--muted); margin-bottom: 10px; }
  .dest-tags { list-style: none; display: flex; gap: 6px; flex-wrap: wrap; }
  .dt { background: var(--sage-lt); color: var(--sage-dk); font-size: 0.72rem; font-weight: 700; padding: 3px 9px; border-radius: 100px; }

  @media (max-width: 900px) { .dest-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 520px) { .dest-grid { grid-template-columns: 1fr; } }
</style>
