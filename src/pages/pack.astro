---
import Base from '../layouts/Base.astro';
import packing from '../data/packing.json';
import ages from '../data/ages.json';
import { LENGTHS, MODES, KIDS, resolveItem, type PackItem } from '../lib/trip';
import Sources from '../components/Sources.astro';

// Server render shows the full list (no trip known yet); the script below tailors it in the browser.
const pillLabel: Record<string, string> = { must: 'Essential', key: 'Important', nice: 'Nice to have', you: 'For you' };
---

<Base title="Your packing list">
  <div class="inner">
    <p class="page-eyebrow">Packing</p>
    <h1 class="page-title">Your packing list</h1>
    <p class="page-sub">Tell us about your trip, then tick things off as you go. Saved on this device.</p>

    <form class="trip-panel" id="trip-form" aria-labelledby="trip-heading">
      <h2 id="trip-heading">Your trip</h2>
      <div class="trip-fields four">
        <div class="form-field">
          <label for="trip-kids">Children</label>
          <select id="trip-kids" name="kids">
            {Object.entries(KIDS).map(([v, l]) => <option value={v}>{l}</option>)}
          </select>
        </div>
        <div class="form-field">
          <label for="trip-age">Youngest's age</label>
          <select id="trip-age" name="age">
            <option value="">Any age</option>
            {ages.map((a) => <option value={a.id}>{a.label}</option>)}
          </select>
        </div>
        <div class="form-field">
          <label for="trip-mode">Travel type</label>
          <select id="trip-mode" name="mode">
            <option value="">Any</option>
            {Object.entries(MODES).map(([v, l]) => <option value={v}>{l}</option>)}
          </select>
        </div>
        <div class="form-field">
          <label for="trip-length">Trip length</label>
          <select id="trip-length" name="length">
            <option value="">Any</option>
            {Object.entries(LENGTHS).map(([v, l]) => <option value={v}>{l}</option>)}
          </select>
        </div>
      </div>
      <p class="trip-status" id="trip-status" aria-live="polite">Showing the full list. Pick your trip details to tailor it.</p>
    </form>

    <p class="multi-note" id="multi-note" hidden>
      Travelling with more than one? There are a few extra things below.
      <a href="/ready#multi">More tips</a>
    </p>

    <div class="progress-wrap">
      <div class="progress-top">
        <div>
          <div class="progress-pct" id="pct">0%</div>
          <div class="progress-desc" id="pct-desc">0 items packed</div>
        </div>
      </div>
      <div class="prog-bar" role="progressbar" aria-labelledby="pct-desc" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="prog-bar">
        <div class="prog-fill" id="prog-fill"></div>
      </div>
    </div>

    {packing.map((section) => (
      <section class="checklist-section" data-section={section.id} aria-labelledby={`sec-${section.id}`}>
        <div class="cs-header">
          <h2 id={`sec-${section.id}`}>{section.title}</h2>
          <span class={`pill pill-${section.badge} cs-badge`}>{section.badgeLabel}</span>
        </div>
        <div class="cs-items">
          {(section.items as PackItem[]).map((raw) => {
            // Items that depend on the trip (e.g. only for several children) are hidden by the script below.
            const item = resolveItem(raw, {}) ?? raw;
            return (
              <div class="ci" data-row={item.id}>
                <label class="ci-main">
                  <input type="checkbox" data-item={item.id} />
                  <strong class="ci-name">{item.name}</strong>
                </label>
                <span class={`pill pill-${item.priority} ci-pill`}>{pillLabel[item.priority]}</span>
                <details class="ci-more">
                  <summary>More info</summary>
                  <span class="ci-note">{item.note}</span>
                  <Sources ids={item.sources} />
                  <span class="review-flag" hidden={!item.needsReview}>Still being double-checked</span>
                </details>
              </div>
            );
          })}
        </div>
      </section>
    ))}

    <div class="next-step pack-actions no-print">
      <button type="button" class="btn-ghost" id="share">Share this list</button>
      <button type="button" class="btn-ghost" id="print">Print</button>
      <button type="button" class="btn-ghost" id="reset">Clear all ticks</button>
      <p class="trip-status" id="share-status" role="status"></p>
      <p><a class="btn-coral" href="/plan">Next: Your countdown →</a></p>
    </div>
  </div>
</Base>

<script>
  import packing from '../data/packing.json';
  import ages from '../data/ages.json';
  import {
    saveTrip, tripFromUrl, resolveItem, shareLink, shareOrCopy,
    PACK_KEY, LENGTHS, MODES, KIDS, type PackItem, type Trip,
  } from '../lib/trip';
  const pillLabel: Record<string, string> = { must: 'Essential', key: 'Important', nice: 'Nice to have', you: 'For you' };
  const ageLabel = (id?: string) => ages.find((a) => a.id === id)?.label;

  const form = document.getElementById('trip-form') as HTMLFormElement;
  const fields = {
    kids: document.getElementById('trip-kids') as HTMLSelectElement,
    age: document.getElementById('trip-age') as HTMLSelectElement,
    mode: document.getElementById('trip-mode') as HTMLSelectElement,
    length: document.getElementById('trip-length') as HTMLSelectElement,
  };
  const boxes = Array.from(document.querySelectorAll<HTMLInputElement>('.ci input[type="checkbox"]'));

  function loadTicks(): Set<string> {
    try { return new Set(JSON.parse(localStorage.getItem(PACK_KEY) || '[]')); } catch { return new Set(); }
  }
  function saveTicks() {
    // Ticks on hidden items are kept, so switching trip type back doesn't lose them.
    try { localStorage.setItem(PACK_KEY, JSON.stringify(boxes.filter((b) => b.checked).map((b) => b.dataset.item))); } catch {}
  }

  function describe(trip: Trip) {
    const many = trip.kids && trip.kids !== '1';
    const age = ageLabel(trip.age);
    const parts = [
      many && KIDS[trip.kids!],
      age && (many ? `youngest ${age}` : age),
      trip.mode && MODES[trip.mode],
      trip.length && LENGTHS[trip.length],
    ].filter(Boolean);
    return parts.length
      ? `Tailored for: ${parts.join(' · ')}`
      : 'Showing the full list. Pick your trip details to tailor it.';
  }

  function applyTrip(trip: Trip) {
    for (const section of packing) {
      let visible = 0;
      for (const raw of section.items as PackItem[]) {
        const row = document.querySelector<HTMLElement>(`[data-row="${raw.id}"]`)!;
        const item = resolveItem(raw, trip);
        row.hidden = !item;
        if (!item) continue;
        visible++;
        row.querySelector('.ci-name')!.textContent = item.name;
        row.querySelector('.ci-note')!.textContent = item.note;
        (row.querySelector('.review-flag') as HTMLElement).hidden = !item.needsReview;
        const pill = row.querySelector('.ci-pill')!;
        pill.className = `pill pill-${item.priority} ci-pill`;
        pill.textContent = pillLabel[item.priority];
      }
      document.querySelector<HTMLElement>(`[data-section="${section.id}"]`)!.hidden = visible === 0;
    }
    document.getElementById('trip-status')!.textContent = describe(trip);
    document.getElementById('multi-note')!.hidden = !trip.kids || trip.kids === '1';
    renderProgress();
  }

  function renderProgress() {
    const shown = boxes.filter((b) => !b.closest<HTMLElement>('.ci')!.hidden);
    const done = shown.filter((b) => b.checked).length;
    const pct = shown.length ? Math.round((done / shown.length) * 100) : 0;
    boxes.forEach((b) => b.closest('.ci')!.classList.toggle('checked', b.checked));
    document.getElementById('pct')!.textContent = `${pct}%`;
    document.getElementById('pct-desc')!.textContent = `${done} of ${shown.length} items packed`;
    document.getElementById('prog-fill')!.style.width = `${pct}%`;
    document.getElementById('prog-bar')!.setAttribute('aria-valuenow', String(pct));
  }

  // Trip: URL params win (e.g. linked from the readiness page), else what was saved.
  let trip = tripFromUrl(ages.map((a) => a.id));
  fields.kids.value = trip.kids ?? '1';
  fields.age.value = trip.age ?? '';
  fields.mode.value = trip.mode ?? '';
  fields.length.value = trip.length ?? '';

  form.addEventListener('change', () => {
    const next: Trip = {
      kids: fields.kids.value || undefined,
      age: fields.age.value || undefined,
      mode: fields.mode.value || undefined,
      length: fields.length.value || undefined,
    };
    trip = { ...trip, ...next };
    saveTrip(trip);
    applyTrip(trip);
  });
  form.addEventListener('submit', (e) => e.preventDefault());

  const ticks = loadTicks();
  boxes.forEach((b) => {
    b.checked = ticks.has(b.dataset.item!);
    b.addEventListener('change', () => { saveTicks(); renderProgress(); });
  });
  document.getElementById('reset')!.addEventListener('click', () => {
    boxes.forEach((b) => (b.checked = false));
    saveTicks(); renderProgress();
  });

  document.getElementById('share')!.addEventListener('click', async () => {
    const result = await shareOrCopy(shareLink('/pack', trip), 'Our TinyTrip packing list');
    document.getElementById('share-status')!.textContent =
      result === 'copied' ? "Link copied. It opens this list, with everything you've ticked, on their phone."
      : result === 'failed' ? "Couldn't share from this browser. Try copying the page address instead." : '';
  });
  document.getElementById('print')!.addEventListener('click', () => window.print());

  applyTrip(trip);
</script>

<style>

  .progress-wrap { margin-bottom: 28px; }
  .progress-top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; margin-bottom: 8px; }
  .progress-pct { font-family: 'Lora', serif; font-size: 1.6rem; font-weight: 700; color: var(--coral-dk); }
  .progress-desc, .progress-cheer { font-size: 0.82rem; color: var(--muted); }
  .progress-cheer { text-align: right; }

  .checklist-section { margin-bottom: 24px; }
  .checklist-section[hidden], .ci[hidden] { display: none; }
  .cs-header { display: flex; align-items: center; gap: 10px; margin-bottom: 12px; }
  .cs-icon { font-size: 1.4rem; }
  .cs-header h2 { font-weight: 700; font-size: 1rem; }
  .cs-badge { margin-left: auto; }
  .cs-items { background: var(--white); border-radius: 16px; box-shadow: var(--shadow); overflow: hidden; }
  .ci {
    display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 4px 12px;
    padding: 12px 20px; border-bottom: 1px solid #F0EBE5; transition: background 0.15s;
  }
  .ci:last-child { border-bottom: none; }
  .ci:hover { background: var(--warm); }
  .ci-main { display: flex; align-items: center; gap: 12px; cursor: pointer; }
  .ci input { width: 18px; height: 18px; accent-color: var(--coral-dk); flex-shrink: 0; cursor: pointer; }
  .ci-name { font-size: 0.9rem; font-weight: 700; }
  .ci-more { grid-column: 1 / -1; padding-left: 30px; }
  .ci-more summary {
    font-size: 0.75rem; font-weight: 700; color: var(--muted); cursor: pointer;
    width: fit-content; list-style: none;
  }
  .ci-more summary::-webkit-details-marker { display: none; }
  .ci-more summary::after { content: ' ▾'; }
  .ci-more[open] summary::after { content: ' ▴'; }
  .ci-note { display: block; margin-top: 4px; font-size: 0.8rem; color: var(--muted); line-height: 1.5; }
  .multi-note {
    background: var(--sky-lt); border: 1px solid #DCEAF5; border-radius: 14px;
    padding: 10px 16px; font-size: 0.85rem; margin: -8px 0 24px;
  }
  .multi-note[hidden] { display: none; }
  .review-flag[hidden] { display: none; }
  .pack-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .pack-actions .btn-ghost { padding: 10px 18px; font-size: 0.9rem; }
  .pack-actions p { flex-basis: 100%; }
  .pack-actions p:last-child { margin-top: 12px; }
  @media print {
    .cs-items { box-shadow: none; border: 1px solid #ccc; }
    .ci { padding: 6px 10px; }
    .ci-more summary { display: none; }
    .progress-cheer { display: none; }
  }
  .ci.checked .ci-name { text-decoration: line-through; opacity: 0.45; }
  .ci.checked .ci-note { opacity: 0.4; }

  @media (max-width: 520px) {
    .ci { padding: 12px 14px; gap: 4px 10px; }
    .progress-cheer { display: none; }
  }
</style>
