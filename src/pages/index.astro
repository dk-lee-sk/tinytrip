---
import Base from '../layouts/Base.astro';
import ages from '../data/ages.json';
import worries from '../data/worries.json';
import { KIDS } from '../lib/trip';

const tools = [
  { href: '/ready', title: 'Is baby ready?', text: 'What to expect at each age' },
  { href: '/plan', title: 'Your countdown', text: 'What to sort, and when' },
  { href: '/pack', title: 'What to pack', text: 'A list that changes with your trip' },
  { href: '/ask', title: 'Questions to ask', text: 'For the airline, train, hotel and car hire' },
  { href: '/travel-day', title: 'Travel-day planner', text: 'Where naps and feeds fall on the journey' },
  { href: '/guides', title: 'Flying with a baby', text: 'Ears, seats, and lap or own seat' },
  { href: '/sleep', title: 'Sleep & time zones', text: 'Bedtimes after a time difference' },
  { href: '/meltdown', title: 'Meltdown help', text: 'What to do in the moment' },
];
---

<Base>
  <section class="hero">
    <svg class="hero-doodle" viewBox="0 0 300 140" aria-hidden="true" focusable="false">
      <path d="M18 112c40-6 62-30 58-52-3-17-24-19-28-4-5 18 26 30 60 18 38-13 70-48 140-58"
            fill="none" stroke="#E07A5F" stroke-width="2.5" stroke-dasharray="2 9" stroke-linecap="round" opacity="0.7" />
      <path d="M14 104c-6-6 2-14 7-8 5-6 13 2 7 8l-7 7z" fill="#F5C4B0" />
      <g transform="translate(250 6) rotate(-14)">
        <path d="M2 14 L40 10 Q48 10 48 14 Q48 18 40 18 L2 14Z" fill="#fff" stroke="#B8573D" stroke-width="2" stroke-linejoin="round" />
        <path d="M18 13 L28 0 L33 1 L28 12Z M20 16 L28 28 L33 27 L28 17Z M4 14 L0 6 L5 6 L10 13Z" fill="#E07A5F" />
      </g>
      <g fill="#fff" opacity="0.9">
        <ellipse cx="200" cy="96" rx="26" ry="9" /><ellipse cx="190" cy="90" rx="13" ry="10" /><ellipse cx="208" cy="88" rx="11" ry="9" />
      </g>
    </svg>
    <div class="hero-copy">
      <p class="section-eyebrow">For first-time parents</p>
      <h1>Your first trip<br />with a baby,<br /><em>one step at a time.</em></h1>
      <p class="hero-sub">
        What to pack, what to ask before you book, and how the travel day might go. Free, no sign-up, and
        anything health-related links to where it comes from.
      </p>
      <div class="hero-actions">
        <a class="btn-coral" href="/ready">Start here: Is baby ready? →</a>
        <a class="btn-ghost" href="/pack">Jump to packing list</a>
      </div>
    </div>

    <form class="hero-card" action="/ready" method="get">
      <h2>Plan your first trip</h2>
      <p class="subtitle">Tell us a little, and we'll guide the rest.</p>
      <div class="form-2col">
        <div class="form-field">
          <label for="home-kids">Children</label>
          <select id="home-kids" name="kids">
            {Object.entries(KIDS).map(([v, l]) => <option value={v}>{l}</option>)}
          </select>
        </div>
        <div class="form-field">
          <label for="home-age">Youngest's age</label>
          <select id="home-age" name="age" required>
            <option value="">Select age...</option>
            {ages.map((a) => <option value={a.id}>{a.label}</option>)}
          </select>
        </div>
      </div>
      <div class="form-2col">
        <div class="form-field">
          <label for="home-length">Trip length</label>
          <select id="home-length" name="length">
            <option value="weekend">Weekend (2–3 nights)</option>
            <option value="short">Short (4–6 nights)</option>
            <option value="week">Week+</option>
          </select>
        </div>
        <div class="form-field">
          <label for="home-mode">Travel type</label>
          <select id="home-mode" name="mode">
            <option value="flight">✈️ Flight</option>
            <option value="road">🚗 Road trip</option>
            <option value="train">🚂 Train</option>
          </select>
        </div>
      </div>
      <p class="reassure-note">You can change any of this later. It's saved on your device, not sent anywhere.</p>
      <button class="btn-coral btn-block" type="submit">Build my travel plan →</button>
    </form>
  </section>

  <section class="worries" aria-labelledby="worries-title">
    <h2 class="section-title" id="worries-title">What's worrying you most?</h2>
    <p class="section-sub">Pick one and we'll point you to the right page.</p>
    <div class="worry-chips" role="group" aria-label="Worries">
      {worries.map((w) => (
        <button type="button" class="worry-chip" data-worry={w.id} aria-pressed="false" aria-controls={`worry-${w.id}`}>
          {w.label}
        </button>
      ))}
    </div>
    <div aria-live="polite">
      {worries.map((w) => (
        <div class="worry-card" id={`worry-${w.id}`} hidden>
          <p class="worry-reassure">{w.reassure}</p>
          <ul class="worry-links">
            {w.links.map((l, i) => (
              <li><a class={i === 0 ? 'btn-coral' : 'btn-ghost'} href={l.href}>{l.label} →</a></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section class="home-guides">
    <h2 class="section-title">Or go straight to a tool</h2>
    <ul class="guide-cards">
      {tools.map((t) => (
        <li>
          <a class="guide-card" href={t.href}>
            <h3>{t.title}</h3>
            <p>{t.text}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>

<script>
  import { loadTrip } from '../lib/trip';

  // Coming back? Pre-fill the form with the trip saved last time.
  const trip = loadTrip();
  const set = (id: string, v?: string) => {
    const el = document.getElementById(id) as HTMLSelectElement | null;
    if (el && v && [...el.options].some((o) => o.value === v)) el.value = v;
  };
  set('home-age', trip.age);
  set('home-length', trip.length);
  set('home-mode', trip.mode);

  // Worry picker: one card open at a time; tapping the same worry again closes it.
  const chips = document.querySelectorAll<HTMLButtonElement>('.worry-chip');
  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const opening = chip.getAttribute('aria-pressed') !== 'true';
      chips.forEach((c) => {
        const on = opening && c === chip;
        c.setAttribute('aria-pressed', String(on));
        document.getElementById(`worry-${c.dataset.worry}`)!.hidden = !on;
      });
    }),
  );
</script>

<style>
  .hero {
    background: linear-gradient(160deg, #FDF0EC 0%, #EAF2EC 100%);
    padding: 72px 60px 60px;
    display: grid; grid-template-columns: 1fr 1fr; gap: 64px; align-items: center;
    position: relative; overflow: hidden;
  }
  .hero-doodle { position: absolute; top: 18px; left: 34%; width: 300px; z-index: 1; pointer-events: none; }
  .hero-copy { position: relative; z-index: 2; }
  .hero-copy .section-eyebrow { margin-bottom: 16px; }
  h1 { font-family: 'Lora', serif; font-size: 3rem; font-weight: 700; line-height: 1.2; margin-bottom: 18px; }
  h1 em { font-style: italic; color: var(--coral-dk); }
  .hero-sub { font-size: 1.05rem; line-height: 1.75; color: var(--muted); margin-bottom: 32px; max-width: 440px; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }

  .hero-card {
    background: var(--white); border-radius: 28px; padding: 36px;
    box-shadow: var(--shadow-lg); position: relative; z-index: 2; border: 1px solid var(--line);
  }
  .hero-card h2 { font-family: 'Lora', serif; font-size: 1.2rem; margin-bottom: 6px; }
  .subtitle { font-size: 0.85rem; color: var(--muted); margin-bottom: 24px; }
  .reassure-note { font-size: 0.82rem; line-height: 1.55; color: var(--muted); margin-bottom: 16px; }

  .worries { padding: 60px 60px 12px; max-width: 1100px; margin: 0 auto; text-align: center; }
  .worries .section-sub { margin-bottom: 24px; }
  .worry-chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; margin-bottom: 20px; }
  .worry-chip {
    font: inherit; font-size: 0.92rem; font-weight: 700; color: var(--deep);
    background: var(--white); border: 2px solid var(--line); border-radius: 100px;
    padding: 10px 18px; cursor: pointer; transition: all 0.2s; box-shadow: var(--shadow);
  }
  .worry-chip:hover { border-color: var(--coral); }
  .worry-chip[aria-pressed="true"] { border-color: var(--coral); background: var(--blush); color: var(--coral-dk); }
  .worry-card {
    max-width: 680px; margin: 0 auto; text-align: left;
    background: var(--sage-lt); border-left: 5px solid var(--sage); border-radius: var(--radius);
    padding: 24px 28px; animation: rise 0.3s ease both;
  }
  .worry-card[hidden] { display: none; }
  .worry-reassure { font-size: 1rem; line-height: 1.7; margin-bottom: 16px; }
  .worry-links { list-style: none; display: flex; flex-wrap: wrap; gap: 10px; }
  .worry-links a { padding: 10px 18px; font-size: 0.9rem; }

  .home-guides { padding: 60px 60px 48px; max-width: 1100px; margin: 0 auto; }
  .guide-cards { list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .home-guides .section-title { margin-bottom: 20px; }
  .guide-card {
    display: block; height: 100%; text-decoration: none;
    background: var(--white); border-radius: 14px; padding: 18px 20px;
    border: 1.5px solid var(--line); transition: border-color 0.2s;
  }
  .guide-card:hover { border-color: var(--coral); }
  .guide-card h3 { font-weight: 700; font-size: 0.95rem; margin-bottom: 6px; line-height: 1.35; }
  .guide-card p { font-size: 0.8rem; color: var(--muted); line-height: 1.55; }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: 32px; padding: 40px 16px; }
    .hero-doodle { top: 8px; left: auto; right: -20px; width: 170px; opacity: 0.8; }
    h1 { font-size: 2.2rem; }
    .hero-card { padding: 24px; }
    .home-guides { padding: 40px 16px; }
    .worries { padding: 40px 16px 0; }
    .worry-card { padding: 20px; }
    .guide-cards { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 520px) {
    .guide-cards { grid-template-columns: 1fr; }
    .worry-chip { font-size: 0.85rem; padding: 8px 14px; }
  }
</style>
