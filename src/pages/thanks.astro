---
import Base from '../layouts/Base.astro';
---

<Base title="Thank you" feedback={false}>
  <div class="inner narrow">
    <p class="page-eyebrow">Feedback sent</p>
    <h1 class="page-title">Thank you 💚</h1>
    <p class="page-sub">
      We read every message. Each one helps make TinyTrip calmer and clearer for the next parent planning their
      first trip.
    </p>
    <a class="btn-coral" href="/plan">Back to your plan →</a>
  </div>
</Base>
