---
import Base from '../layouts/Base.astro';
import guides from '../data/guides.json';
import Sources from '../components/Sources.astro';

const g = guides[0];
---

<Base title="Flying with a baby" description="Little ears, choosing seats, lap or own seat, and what the crew can and can't do.">
  <article class="inner narrow" id={g.id}>
    <p class="page-eyebrow">Guide</p>
    <h1 class="page-title">Flying with a baby</h1>
    <p class="page-sub">{g.summary}.</p>

    <div class="guide-body">
      {g.sections.map((s) => (
        <>
          <h2>{s.heading}</h2>
          {s.text && <p>{s.text}</p>}
          {s.list && <ul>{s.list.map((li) => <li>{li}</li>)}</ul>}
        </>
      ))}
      <div class="guide-tip"><strong>{g.tip.label}:</strong> {g.tip.text}</div>
      <Sources ids={g.sources} />
      {g.needsReview && <span class="review-flag">Still being double-checked</span>}
    </div>

    <p class="next-step"><a class="btn-ghost" href="/ask#airline">Questions to ask the airline →</a></p>
  </article>
</Base>

<style>
  .guide-body {
    background: var(--white); border-radius: 18px; box-shadow: var(--shadow);
    padding: 28px 32px; font-size: 0.92rem; line-height: 1.75;
  }
  .guide-body h2 { font-weight: 700; font-size: 1rem; margin: 20px 0 6px; color: var(--coral-dk); }
  .guide-body h2:first-child { margin-top: 0; }
  .guide-body ul { padding-left: 18px; }
  .guide-body li { margin-bottom: 6px; }
  .guide-tip {
    background: var(--gold-lt); border-left: 3px solid var(--gold);
    border-radius: 0 10px 10px 0; padding: 12px 16px; margin-top: 18px; font-size: 0.88rem;
  }
  .guide-tip strong { color: #8A6000; }

  @media (max-width: 520px) { .guide-body { padding: 20px 18px; } }
</style>
